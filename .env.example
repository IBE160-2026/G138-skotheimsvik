# Step 1: Register an OAuth App at https://github.com/settings/applications/new
#   - Application name: LearningHub
#   - Homepage URL: http://localhost:8080 (or https://g138-skotheimsvik.vercel.app)
#   - Authorization callback URL: http://localhost:8080 (or https://g138-skotheimsvik.vercel.app)
#
# Copy this file to .env and fill in your Client ID and Client Secret:
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
